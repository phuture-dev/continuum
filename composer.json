{
    "name": "phuture/continuum",
    "description": "A forward-compatibility layer bringing tomorrow’s PHP features to today’s runtimes.",
    "type": "library",
    "keywords": ["polyfill", "shim", "compatibility", "portable"],
    "license": "MIT",
    "authors": [
        {
            "name": "Phuture",
            "homepage": "https://www.phuture.dev"
        },
        {
            "name": "Advandz Technologies, LLC",
            "homepage": "https://www.advandz.com"
        }
    ],
    "require": {
        "php": "^8.0",
        "league/uri-interfaces": "^2.3.0 || ^7.8.0",
        "nette/robot-loader": "^v4.0.0 || ^v4.1.0",
        "phpseclib/bcmath_compat": "~v2.0.0",
        "psr/http-message": "^1.1.0 || ^2.0.0",
        "rowbot/idna": "^0.1.0 || ^0.3.0",
        "rowbot/url": "^3.1.0 || ^4.1.0",
        "nelexa/zip": "^4.0.0",
        "zendtech/polyfill-mb-ereg": "^1.0.0",
        "symfony/polyfill-apcu": "~v1.37.0",
        "symfony/polyfill-ctype": "~v1.37.0",
        "symfony/polyfill-iconv": "~v1.37.0",
        "symfony/polyfill-intl-grapheme": "~v1.41.0",
        "symfony/polyfill-intl-icu": "~v1.38.0",
        "symfony/polyfill-intl-idn": "~v1.38.0",
        "symfony/polyfill-intl-messageformatter": "~v1.38.0",
        "symfony/polyfill-intl-normalizer": "~v1.38.0",
        "symfony/polyfill-mbstring": "~v1.38.0",
        "symfony/polyfill-php81": "~v1.38.0",
        "symfony/polyfill-php82": "~v1.38.0",
        "symfony/polyfill-php83": "~v1.38.0",
        "symfony/polyfill-php84": "~v1.38.0",
        "symfony/polyfill-php85": "~v1.41.0",
        "symfony/polyfill-php86": "~v1.41.0",
        "symfony/polyfill-uuid": "~v1.37.0"
    },
    "require-dev": {
        "nette/tester": "^2.5",
        "phpstan/phpstan": "^2.0",
        "squizlabs/php_codesniffer": "^3.7 || ^4.0",
        "friendsofphp/php-cs-fixer": "^3.92.0"
    },
    "replace": {
        "league/uri-polyfill": "^7.8.0"
    },
    "provide": {
        "ext-bcmath": "*",
        "ext-apcu": "*",
        "ext-ctype": "*",
        "ext-mbstring": "*",
        "ext-iconv": "*",
        "ext-uuid": "*",
        "ext-intl": "*",
        "ext-zip": "*"
    },
    "autoload": {
        "psr-4": {
            "Phuture\\Continuum\\": "src/"
        },
        "files": [
            "src/bootstrap.php"
        ],
        "classmap": [
            "src/Resources"
        ]
    },
    "autoload-dev": {
        "psr-4": {
            "Phuture\\Continuum\\Tests\\": "tests/"
        }
    },
    "scripts": {
        "test": ["@phpcs", "@phpstan", "@tester"],
        "lint": "php-cs-fixer fix",
        "server": "php -S localhost:8000",
        "phpstan": "phpstan analyse src --memory-limit=4294967296",
        "phpcs": "phpcs --standard=PSR12 src",
        "tester": "tester tests -s -C"
    },
    "config": {
        "sort-packages": true,
        "optimize-autoloader": true
    },
    "minimum-stability": "stable",
    "prefer-stable": true,
    "extra": {
        "thanks": {
            "name": "symfony/polyfill",
            "url": "https://github.com/symfony/polyfill"
        }
    }
}
